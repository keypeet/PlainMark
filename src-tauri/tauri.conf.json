{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlainMark",
  "version": "0.8.1",
  "identifier": "com.plainmark.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PlainMark",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "maximizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: http: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "PlainMark",
    "shortDescription": "Plain-text-first Markdown editor",
    "longDescription": "PlainMark is a distraction-free Markdown editor with live preview, note groups, and always-on autosave.",
    "copyright": "Copyright (c) 2026 PlainMark",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
